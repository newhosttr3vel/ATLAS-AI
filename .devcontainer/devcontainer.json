{
  "name": "ATLAS AI - Cloud Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": { "label": "ATLAS AI API", "onAutoForward": "notify" },
    "8501": { "label": "ATLAS AI Dashboard", "onAutoForward": "notify" }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt && if [ ! -f .env ]; then cp .env.example .env; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "remoteUser": "vscode"
}
